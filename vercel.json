{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dm", "destination": "/dm.html" },
    { "source": "/trainer", "destination": "/trainer.html" },
    { "source": "/download", "destination": "/index.html" },
    { "source": "/kompendium", "destination": "/kompendium.html" },
    { "source": "/api/(.*)", "destination": "/api?endpoint=$1" }
  ]
}
